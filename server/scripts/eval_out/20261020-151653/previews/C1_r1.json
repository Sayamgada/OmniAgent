        "branch": "approved",
        "n8n_resolved": true,
        "n8n_operation": {
          "label": "Send",
          "value": "send",
          "action": "Send a message"
        },
        "n8n_resolution_kind": "action_node"
      },
      {
        "step": 3,
        "service": "gmail",
        "operation": "send",
        "target": "message",
        "parameters": {},
        "depends_on": [
          1
        ],
        "branch": "rejected",
        "n8n_resolved": true,
        "n8n_operation": {
          "label": "Send",
          "value": "send",
          "action": "Send a message"
        },
        "n8n_resolution_kind": "action_node"
      }
    ],
    "output": "An email reply sent to the employee indicating approval or rejection of their leave request."
